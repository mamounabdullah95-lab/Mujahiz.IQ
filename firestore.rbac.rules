rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function myUser() { return userDoc(request.auth.uid).data; }
    function hasAnyRole(roles) { return signedIn() && myUser().role in roles; }
    function isAdmin() { return hasAnyRole(["owner", "admin"]); }
    function isOwner() { return hasAnyRole(["owner"]); }
    function isBuyer() { return signedIn() && (myUser().accountType == "buyer" || (!("accountType" in myUser()) && myUser().role == "contributor")); }
    function isSupplierAccount() { return signedIn() && myUser().accountType == "supplier"; }
    function isApproved() { return signedIn() && myUser().status == "approved"; }
    function hasActiveAccess() { return isAdmin() || (isApproved() && myUser().accessStatus in ["active", "temporary"] && myUser().accessExpiresAt is timestamp && myUser().accessExpiresAt > request.time); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function canSubmitCompany() { return signedIn() && myUser().status != "suspended" && (isBuyer() || isSupplierAccount() || isAdmin()); }
    function isOwnSupplierProfile(supplierId) { return isSupplierAccount() && "supplierProfileId" in myUser() && myUser().supplierProfileId == supplierId; }
    function supplierDoc(supplierId) { return get(/databases/$(database)/documents/suppliers/$(supplierId)); }
    function isVerifiedRequest() { return signedIn() && request.auth.token.email_verified == true; }
    function buyerDataHasPortalIdentity(user) {
      return user.role == "contributor"
        && (("accountType" in user && user.accountType == "buyer")
          || (!("accountType" in user)));
    }
    function isBuyerPortalIdentity(uid) {
      let user = userDoc(uid).data;
      return buyerDataHasPortalIdentity(user);
    }
    function buyerAccountCanWrite(uid) {
      let user = userDoc(uid).data;
      return buyerDataHasPortalIdentity(user)
        && user.status == "approved"
        && user.emailVerified == true
        && user.accessStatus in ["active", "temporary"]
        && user.accessExpiresAt is timestamp
        && user.accessExpiresAt > request.time;
    }
    function currentBuyerCanWrite() {
      return isVerifiedRequest() && buyerAccountCanWrite(request.auth.uid);
    }
    function supplierAccountCanWrite(uid, supplierId) {
      let user = userDoc(uid).data;
      let supplier = supplierDoc(supplierId).data;
      return user.role == "contributor"
        && user.accountType == "supplier"
        && user.status == "approved"
        && user.emailVerified == true
        && user.accessStatus != "suspended"
        && user.supplierProfileId == supplierId
        && supplier.status == "approved"
        && supplier.canReceiveRfqs == true
        && supplier.accountOwnerId == uid;
    }
    function currentSupplierCanWrite(supplierId) {
      return isVerifiedRequest() && supplierAccountCanWrite(request.auth.uid, supplierId);
    }
    function supplierIsTargeted(data) {
      let user = myUser();
      return "supplierProfileId" in user
        && user.supplierProfileId in data.recipientIds
        && currentSupplierCanWrite(user.supplierProfileId);
    }
    function conversationParticipantCanWrite(data, uid) {
      let user = userDoc(uid).data;
      return data.supplierId is string
        && data.participantIds is list
        && uid in data.participantIds
        && (user.accountType == "supplier"
          ? supplierAccountCanWrite(uid, data.supplierId)
          : buyerAccountCanWrite(uid));
    }
    function currentConversationParticipantCanWrite(data) {
      return isVerifiedRequest()
        && conversationParticipantCanWrite(data, request.auth.uid);
    }
    function noStoredFileFields(data) {
      return !("fileUrl" in data)
        && !("downloadUrl" in data)
        && !("storagePath" in data)
        && !("fileContent" in data)
        && !("base64" in data)
        && !("attachmentUrl" in data)
        && !("imageUrl" in data)
        && !("workbook" in data)
        && !("workbookData" in data)
        && !("rawWorkbook" in data)
        && !("rawFile" in data)
        && !("rawFileData" in data)
        && !("fileBytes" in data)
        && !("blob" in data)
        && !("arrayBuffer" in data)
        && !("binary" in data)
        && !("rawData" in data)
        && !("filePayload" in data);
    }
    function validReferenceLinks(links) {
      return links is list
        && links.size() <= 5
        && (links.size() < 1 || (links[0] is string && links[0].size() > 0 && links[0].size() <= 500 && links[0].matches('https://.+')))
        && (links.size() < 2 || (links[1] is string && links[1].size() > 0 && links[1].size() <= 500 && links[1].matches('https://.+')))
        && (links.size() < 3 || (links[2] is string && links[2].size() > 0 && links[2].size() <= 500 && links[2].matches('https://.+')))
        && (links.size() < 4 || (links[3] is string && links[3].size() > 0 && links[3].size() <= 500 && links[3].matches('https://.+')))
        && (links.size() < 5 || (links[4] is string && links[4].size() > 0 && links[4].size() <= 500 && links[4].matches('https://.+')));
    }
    function canImportSupplierExcel() {
      return signedIn() && myUser().status != "suspended" && (isBuyer() || isAdmin());
    }
    function importerRoleMatches(role) {
      return (isOwner() && role == "owner")
        || (hasAnyRole(["admin"]) && role == "admin")
        || (isBuyer() && role == "buyer");
    }
    function validExcelImportSubmission(data, submissionId) {
      return canImportSupplierExcel()
        && data.keys().hasOnly(["submittedBy", "submissionStatus", "supplierData", "duplicateCheck", "countsForAccess", "creditConsumed", "source", "importBatchId", "originalRowNumber", "importedBy", "importedByRole", "importedAt", "profileCompleteness", "validationStatus", "idempotencyKey", "duplicateOverrideReason", "createdAt"])
        && data.source == "excel_import"
        && data.submittedBy == request.auth.uid
        && data.importedBy == request.auth.uid
        && importerRoleMatches(data.importedByRole)
        && data.importBatchId is string
        && data.originalRowNumber is int
        && data.originalRowNumber >= 2
        && data.originalRowNumber <= 51
        && data.profileCompleteness is int
        && data.profileCompleteness >= 0
        && data.profileCompleteness <= 100
        && data.validationStatus in ["valid", "needs_review", "possible_duplicate"]
        && data.idempotencyKey == submissionId
        && data.submissionStatus in ["pending_review", "possible_duplicate"]
        && data.countsForAccess == false
        && data.creditConsumed == false
        && data.supplierData is map
        && data.duplicateCheck is map
        && (!(data.submissionStatus == "possible_duplicate") || (isAdmin() && data.duplicateOverrideReason is string && data.duplicateOverrideReason.size() >= 10))
        && noStoredFileFields(data)
        && noStoredFileFields(data.supplierData);
    }
    function validSupplierImportBatch(data) {
      return canImportSupplierExcel()
        && data.keys().hasOnly(["source", "importedBy", "importedByRole", "originalFileName", "fileSizeBytes", "totalRowsDetected", "acceptedRows", "incompleteRows", "invalidRows", "exactDuplicateRows", "possibleDuplicateRows", "averageCompleteness", "createdAt", "completedAt", "status"])
        && data.source == "excel_import"
        && data.importedBy == request.auth.uid
        && importerRoleMatches(data.importedByRole)
        && data.originalFileName is string
        && data.originalFileName.size() > 0
        && data.originalFileName.size() <= 140
        && data.fileSizeBytes is int
        && data.fileSizeBytes > 0
        && data.fileSizeBytes <= 204800
        && data.totalRowsDetected is int
        && data.totalRowsDetected > 0
        && data.totalRowsDetected <= 50
        && data.acceptedRows is int
        && data.acceptedRows > 0
        && data.acceptedRows <= data.totalRowsDetected
        && data.averageCompleteness is int
        && data.averageCompleteness >= 0
        && data.averageCompleteness <= 100
        && data.status == "completed"
        && noStoredFileFields(data);
    }
    function validPendingSubmissionIndex(data, indexId) {
      return canSubmitCompany()
        && data.keys().hasOnly(["submissionId", "submittedBy", "supplierName", "normalizedName", "normalizedPhones", "normalizedEmail", "website", "googleMapsLink", "governorate", "categories", "source", "createdAt"])
        && data.submissionId == indexId
        && data.submittedBy == request.auth.uid
        && data.supplierName is string
        && data.supplierName.size() > 0
        && data.normalizedName is string
        && data.normalizedPhones is list
        && data.categories is list
        && data.source == "pending_submission"
        && noStoredFileFields(data);
    }
    function isValidOwnSupplierImportAudit() {
      return canImportSupplierExcel()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action == "supplier_import.completed"
        && request.resource.data.targetType == "supplierImportBatch";
    }

    function canAdminUpdateUser() {
      return isOwner() || (hasAnyRole(["admin"])
        && resource.data.role in ["contributor", "viewer", "suspended"]
        && request.resource.data.role in ["contributor", "viewer", "suspended"]
        && ((!("accountType" in resource.data) && !("accountType" in request.resource.data)) || ("accountType" in resource.data && "accountType" in request.resource.data && request.resource.data.accountType == resource.data.accountType)));
    }
    function onlySelfEditableProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullName", "phone", "jobTitle", "organization", "governorate", "city", "sector", "otherSector", "reasonForJoining", "language", "updatedAt"]);
    }
    function isValidSelfRegistration(userId) {
      return isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountType in ["buyer", "supplier"]
        && request.resource.data.role == "contributor"
        && request.resource.data.status == "approved"
        && request.resource.data.accessStatus == "pending"
        && request.resource.data.accessExpiresAt == null
        && request.resource.data.trialStartedAt == null
        && request.resource.data.trialEndsAt == null
        && request.resource.data.emailVerified == false
        && request.resource.data.points == 5
        && request.resource.data.trustScore == 0
        && request.resource.data.totalSubmissions == 0
        && request.resource.data.approvedSubmissions == 0
        && request.resource.data.rejectedSubmissions == 0
        && request.resource.data.duplicateSubmissions == 0
        && request.resource.data.approvedReviews == 0
        && request.resource.data.approvedNewSupplierContributions == 0
        && request.resource.data.consumedApprovedSupplierContributions == 0;
    }
    function isValidEmailVerificationSync() {
      return signedIn()
        && request.auth.token.email_verified == true
        && resource.data.emailVerified == false
        && request.resource.data.emailVerified == true
        && request.resource.data.emailVerifiedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["emailVerified", "emailVerifiedAt", "updatedAt"]);
    }
    function isValidBuyerTrialActivation() {
      return signedIn()
        && request.auth.token.email_verified == true
        && resource.data.accountType == "buyer"
        && resource.data.accessStatus == "pending"
        && resource.data.accessExpiresAt == null
        && resource.data.trialStartedAt == null
        && resource.data.trialEndsAt == null
        && resource.data.emailVerified == false
        && request.resource.data.emailVerified == true
        && request.resource.data.emailVerifiedAt is timestamp
        && request.resource.data.accessStatus == "temporary"
        && request.resource.data.accessExpiresAt is timestamp
        && request.resource.data.accessExpiresAt > request.time
        && request.resource.data.accessExpiresAt <= request.time + duration.value(4, "d")
        && request.resource.data.trialStartedAt is timestamp
        && request.resource.data.trialEndsAt == request.resource.data.accessExpiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["emailVerified", "emailVerifiedAt", "trialStartedAt", "trialEndsAt", "accessStatus", "accessExpiresAt", "updatedAt"]);
    }
    function isValidOwnTrialCredit(documentId) {
      return signedIn() && request.auth.token.email_verified == true
        && isBuyer()
        && documentId == "trial-" + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.source == "trial_access"
        && request.resource.data.grantType == "trial_access"
        && request.resource.data.approvedSubmissionIds is list
        && request.resource.data.approvedSupplierCount == 0
        && request.resource.data.daysGranted is int
        && request.resource.data.daysGranted >= 0
        && request.resource.data.daysGranted <= 14
        && request.resource.data.status == "applied"
        && request.resource.data.createdBy == request.auth.uid;
    }
    function isValidOwnVerificationAudit(documentId) {
      return signedIn() && request.auth.token.email_verified == true
        && documentId == "email-verification-" + request.auth.uid
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action in ["user.email_verified", "user.email_verified_trial_started"]
        && (request.resource.data.action == "user.email_verified" || isBuyer())
        && request.resource.data.targetType == "user"
        && request.resource.data.targetId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isValidSelfRegistration(userId);
      allow read: if isSelf(userId) || isAdmin();
      allow update: if canAdminUpdateUser() || (isSelf(userId) && (onlySelfEditableProfileFields() || isValidEmailVerificationSync() || isValidBuyerTrialActivation()));
      allow delete: if isOwner() && userId != request.auth.uid;
    }

    match /suppliers/{supplierId} {
      allow read: if isAdmin() || (isBuyer() && hasActiveAccess()) || isOwnSupplierProfile(supplierId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwnSupplierProfile(supplierId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["categories", "subcategories", "updatedAt"]));
      allow delete: if isOwner();
    }

    match /supplierDuplicateIndex/{supplierId} {
      allow read: if canSubmitCompany();
      allow create, update, delete: if isAdmin();
    }

    match /supplierSubmissions/{submissionId} {
      allow create: if validExcelImportSubmission(request.resource.data, submissionId) || (
        canSubmitCompany()
        && (!("source" in request.resource.data) || request.resource.data.source == "manual")
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submissionStatus in ["draft", "pending_review", "possible_duplicate"]
        && request.resource.data.supplierData is map
        && noStoredFileFields(request.resource.data)
        && noStoredFileFields(request.resource.data.supplierData)
      );
      allow read: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isAdmin() || (
        canSubmitCompany()
        && resource.data.submittedBy == request.auth.uid
        && resource.data.submissionStatus in ["draft", "needs_correction"]
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submissionStatus in ["draft", "pending_review", "possible_duplicate"]
        && request.resource.data.supplierData is map
        && noStoredFileFields(request.resource.data)
        && noStoredFileFields(request.resource.data.supplierData)
      );
      allow delete: if isAdmin() || (canSubmitCompany() && resource.data.submittedBy == request.auth.uid && resource.data.submissionStatus == "draft");
    }

    match /supplierImportBatches/{batchId} {
      allow create: if validSupplierImportBatch(request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.importedBy == request.auth.uid);
      allow update, delete: if false;
    }

    match /supplierSubmissionDuplicateIndex/{indexId} {
      allow read: if canSubmitCompany();
      allow create: if validPendingSubmissionIndex(request.resource.data, indexId);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedBy == request.auth.uid
        && validPendingSubmissionIndex(request.resource.data, indexId)
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isBuyer() && request.resource.data.userId == request.auth.uid && request.resource.data.supplierId is string;
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /rfqs/{rfqId} {
      function publishEventAfter() {
        return getAfter(/databases/$(database)/documents/rfqPublishEvents/$(rfqId));
      }
      function hasMatchingPublishEvent(data) {
        let event = publishEventAfter().data;
        return event.type == "rfq_published"
          && event.actorId == request.auth.uid
          && event.buyerId == data.buyerId
          && event.rfqId == rfqId
          && event.recipientIds == data.recipientIds
          && event.createdAt == request.time;
      }
      function validRfq(data) {
        return data.keys().hasOnly(["buyerId", "title", "description", "quantity", "unit", "unitOther", "location", "deliveryGovernorate", "deliveryAddress", "preferredCurrency", "paymentTerms", "paymentTermsOther", "deliveryTerms", "deliveryTermsOther", "referenceLinks", "closingDate", "closingAt", "categoryId", "recipientIds", "status", "attachmentStatus", "createdAt", "updatedAt"])
          && data.buyerId is string
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
          && data.quantity is int && data.quantity > 0
          && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 40
          && (!("unitOther" in data) || (data.unitOther is string && data.unitOther.size() <= 120))
          && data.location is string && data.location.size() <= 350
          && (!("deliveryGovernorate" in data) || (data.deliveryGovernorate is string && data.deliveryGovernorate.size() <= 40))
          && (!("deliveryAddress" in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300))
          && (!("preferredCurrency" in data) || data.preferredCurrency in ["IQD", "USD", "either"])
          && (!("paymentTerms" in data) || (data.paymentTerms is string && data.paymentTerms.size() <= 40))
          && (!("paymentTermsOther" in data) || (data.paymentTermsOther is string && data.paymentTermsOther.size() <= 120))
          && (!("deliveryTerms" in data) || (data.deliveryTerms is string && data.deliveryTerms.size() <= 40))
          && (!("deliveryTermsOther" in data) || (data.deliveryTermsOther is string && data.deliveryTermsOther.size() <= 120))
          && (!("referenceLinks" in data) || validReferenceLinks(data.referenceLinks))
          && data.closingDate is string
          && data.closingAt is timestamp
          && data.categoryId is string && data.categoryId.size() > 0
          && data.recipientIds is list && data.recipientIds.size() <= 50
          && data.status in ["draft", "published", "receiving", "closed", "cancelled"]
          && data.attachmentStatus == "upload_pending_launch"
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && noStoredFileFields(data);
      }
      function publishable(data) { return data.recipientIds.size() > 0 && data.closingAt >= request.time; }
      function rfqIdentityUnchanged() {
        return request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.createdAt == resource.data.createdAt;
      }
      function buyerCanUpdateDraft() {
        return resource.data.status == "draft"
          && validRfq(request.resource.data)
          && (request.resource.data.status in ["draft", "cancelled"]
            || (request.resource.data.status == "published"
              && publishable(request.resource.data)
              && hasMatchingPublishEvent(request.resource.data)));
      }
      function buyerCanTransitionOpenRfq() {
        return resource.data.status in ["published", "receiving"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.status in ["closed", "cancelled"];
      }
      function buyerCanUpdateRfq() {
        return !currentBuyerCanWrite()
          ? false
          : resource.data.buyerId != request.auth.uid
            ? false
            : !rfqIdentityUnchanged()
              ? false
              : resource.data.status == "draft"
                ? buyerCanUpdateDraft()
                : resource.data.status in ["published", "receiving"] && buyerCanTransitionOpenRfq();
      }
      allow create: if currentBuyerCanWrite() && request.resource.data.buyerId == request.auth.uid
        && validRfq(request.resource.data)
        && (request.resource.data.status == "draft"
          || (request.resource.data.status == "published"
            && publishable(request.resource.data)
            && hasMatchingPublishEvent(request.resource.data)));
      allow read: if isAdmin()
        || (signedIn() && isBuyerPortalIdentity(request.auth.uid) && resource.data.buyerId == request.auth.uid)
        || supplierIsTargeted(resource.data);
      allow update: if buyerCanUpdateRfq();
      allow delete: if currentBuyerCanWrite() && resource.data.buyerId == request.auth.uid && resource.data.status == "draft";
    }

    match /rfqResponses/{responseId} {
      function requestedRfq() { return get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)); }
      function storedRfq() { return get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)); }
      function responseEventAfter() {
        return getAfter(/databases/$(database)/documents/rfqResponseEvents/$(responseId));
      }
      function hasMatchingResponseEvent(data) {
        let event = responseEventAfter().data;
        return event.type == "rfq_response_submitted"
          && event.actorId == request.auth.uid
          && event.rfqId == data.rfqId
          && event.responseId == responseId
          && event.supplierProfileId == data.supplierProfileId
          && event.createdAt == request.time;
      }
      function rfqCanReceiveResponse(data, supplierProfileId) {
        return data.status in ["published", "receiving"]
          && data.closingAt is timestamp
          && data.closingAt >= request.time
          && supplierProfileId in data.recipientIds;
      }
      function validResponse(data) {
        return data.keys().hasOnly(["id", "rfqId", "supplierUserId", "supplierProfileId", "message", "price", "currency", "deliveryDays", "paymentTerms", "paymentTermsOther", "deliveryTerms", "deliveryTermsOther", "referenceLinks", "status", "attachmentStatus", "createdAt", "updatedAt"])
          && data.id == responseId
          && data.rfqId is string
          && data.supplierUserId == request.auth.uid
          && data.supplierProfileId is string
          && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
          && (!("price" in data) || ((data.price is int || data.price is float) && data.price >= 0))
          && (!("deliveryDays" in data) || (data.deliveryDays is int && data.deliveryDays > 0))
          && data.currency in ["IQD", "USD"]
          && (!("paymentTerms" in data) || (data.paymentTerms is string && data.paymentTerms.size() <= 40))
          && (!("paymentTermsOther" in data) || (data.paymentTermsOther is string && data.paymentTermsOther.size() <= 120))
          && (!("deliveryTerms" in data) || (data.deliveryTerms is string && data.deliveryTerms.size() <= 40))
          && (!("deliveryTermsOther" in data) || (data.deliveryTermsOther is string && data.deliveryTermsOther.size() <= 120))
          && (!("referenceLinks" in data) || validReferenceLinks(data.referenceLinks))
          && data.status in ["submitted", "withdrawn"]
          && data.attachmentStatus == "upload_pending_launch"
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && noStoredFileFields(data);
      }
      function responseIdentityUnchanged() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.rfqId == resource.data.rfqId
          && request.resource.data.supplierUserId == resource.data.supplierUserId
          && request.resource.data.supplierProfileId == resource.data.supplierProfileId
          && request.resource.data.createdAt == resource.data.createdAt;
      }
      allow create: if currentSupplierCanWrite(request.resource.data.supplierProfileId)
        && responseId == request.resource.data.rfqId + "_" + request.auth.uid
        && validResponse(request.resource.data)
        && request.resource.data.status == "submitted"
        && rfqCanReceiveResponse(requestedRfq().data, request.resource.data.supplierProfileId)
        && hasMatchingResponseEvent(request.resource.data);
      allow read: if isAdmin()
        || (signedIn()
          && resource.data.supplierUserId == request.auth.uid
          && currentSupplierCanWrite(resource.data.supplierProfileId))
        || (signedIn()
          && isBuyerPortalIdentity(request.auth.uid)
          && storedRfq().data.buyerId == request.auth.uid);
      allow update: if resource.data.supplierUserId == request.auth.uid
        && currentSupplierCanWrite(resource.data.supplierProfileId)
        && responseIdentityUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["message", "price", "currency", "deliveryDays", "paymentTerms", "paymentTermsOther", "deliveryTerms", "deliveryTermsOther", "referenceLinks", "status", "updatedAt"])
        && validResponse(request.resource.data)
        && rfqCanReceiveResponse(storedRfq().data, resource.data.supplierProfileId);
      allow delete: if false;
    }

    match /rfqPublishEvents/{eventId} {
      function eventRfqPath() {
        return /databases/$(database)/documents/rfqs/$(request.resource.data.rfqId);
      }
      function publishedRfqAfter() {
        return getAfter(eventRfqPath());
      }
      function validPublishEvent() {
        let data = request.resource.data;
        let rfq = publishedRfqAfter().data;
        return signedIn()
          && data.keys().hasOnly(["type", "actorId", "buyerId", "rfqId", "recipientIds", "createdAt"])
          && data.type == "rfq_published"
          && data.rfqId == eventId
          && data.actorId == request.auth.uid
          && data.buyerId == request.auth.uid
          && data.recipientIds is list
          && data.recipientIds.size() > 0
          && data.recipientIds.size() <= 50
          && data.createdAt == request.time
          && rfq.buyerId == request.auth.uid
          && rfq.status == "published"
          && rfq.recipientIds == data.recipientIds
          && rfq.updatedAt == request.time;
      }
      allow create: if validPublishEvent();
      allow read, update, delete: if false;
    }

    match /rfqResponseEvents/{eventId} {
      function eventResponsePath() {
        return /databases/$(database)/documents/rfqResponses/$(request.resource.data.responseId);
      }
      function eventRfq() {
        return get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId));
      }
      function responseAfter() {
        return getAfter(eventResponsePath());
      }
      function validResponseEvent() {
        let data = request.resource.data;
        let response = responseAfter().data;
        let rfq = eventRfq().data;
        return signedIn()
          && data.keys().hasOnly(["type", "actorId", "buyerId", "rfqId", "responseId", "supplierProfileId", "createdAt"])
          && data.type == "rfq_response_submitted"
          && data.responseId == eventId
          && data.actorId == request.auth.uid
          && data.rfqId is string
          && data.buyerId == rfq.buyerId
          && data.supplierProfileId is string
          && data.createdAt == request.time
          && response.id == eventId
          && response.rfqId == data.rfqId
          && response.supplierUserId == request.auth.uid
          && response.supplierProfileId == data.supplierProfileId
          && response.status == "submitted"
          && response.createdAt == request.time
          && response.updatedAt == request.time
          && rfq.status in ["published", "receiving"]
          && rfq.closingAt is timestamp
          && rfq.closingAt >= request.time
          && data.supplierProfileId in rfq.recipientIds;
      }
      allow create: if validResponseEvent();
      allow read, update, delete: if false;
    }

    match /conversations/{conversationId} {
      function conversationSupplier(data) {
        return get(/databases/$(database)/documents/suppliers/$(data.supplierId));
      }
      function conversationRfq(data) {
        return get(/databases/$(database)/documents/rfqs/$(data.rfqId));
      }
      function hasExactParticipants(data, buyerId, supplierOwnerId) {
        return buyerId != supplierOwnerId
          && data.participantIds is list
          && data.participantIds.size() == 2
          && buyerId in data.participantIds
          && supplierOwnerId in data.participantIds;
      }
      function validConversationShape(data) {
        return data.keys().hasOnly(["id", "participantIds", "participantLabels", "rfqId", "supplierId", "lastMessage", "lastMessageAt", "createdAt", "updatedAt"])
          && data.id == conversationId
          && data.participantIds is list
          && data.participantIds.size() == 2
          && data.participantLabels is map
          && data.participantLabels.keys().hasAll(data.participantIds)
          && data.participantLabels.keys().hasOnly(data.participantIds)
          && (!("lastMessage" in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000))
          && (!("lastMessageAt" in data) || data.lastMessageAt is timestamp)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && noStoredFileFields(data);
      }
      function validDirectSupplierConversation(data) {
        let supplier = conversationSupplier(data).data;
        return currentBuyerCanWrite()
          && data.supplierId is string
          && !("rfqId" in data)
          && supplierAccountCanWrite(supplier.accountOwnerId, data.supplierId)
          && hasExactParticipants(data, request.auth.uid, supplier.accountOwnerId);
      }
      function validRfqConversation(data) {
        let rfq = conversationRfq(data).data;
        let supplier = conversationSupplier(data).data;
        return data.supplierId is string
          && data.rfqId is string
          && buyerAccountCanWrite(rfq.buyerId)
          && supplierAccountCanWrite(supplier.accountOwnerId, data.supplierId)
          && data.supplierId in rfq.recipientIds
          && hasExactParticipants(data, rfq.buyerId, supplier.accountOwnerId)
          && (request.auth.uid == rfq.buyerId
            ? currentBuyerCanWrite()
            : currentSupplierCanWrite(data.supplierId));
      }
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if validConversationShape(request.resource.data)
        && (validDirectSupplierConversation(request.resource.data) || validRfqConversation(request.resource.data));
      allow update: if currentConversationParticipantCanWrite(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantLabels == resource.data.participantLabels
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.createdAt == resource.data.createdAt
        && ((!("rfqId" in resource.data) && !("rfqId" in request.resource.data))
          || ("rfqId" in resource.data && request.resource.data.rfqId == resource.data.rfqId))
        && request.resource.data.updatedAt is timestamp
        && (!("lastMessage" in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000))
        && (!("lastMessageAt" in request.resource.data) || request.resource.data.lastMessageAt is timestamp)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "lastMessageAt", "updatedAt"]);
      allow delete: if false;
    }

    match /messages/{messageId} {
      function conversation() { return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)); }
      function storedConversation() { return get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)); }
      function validParticipantReadBy(readBy, participantIds) {
        return readBy is list
          && readBy.size() >= 1
          && readBy.size() <= 2
          && (readBy.size() < 1 || readBy[0] in participantIds)
          && (readBy.size() < 2 || (readBy[1] in participantIds && readBy[0] != readBy[1]));
      }
      function existingReceiptsPreserved() {
        return request.resource.data.readBy.size() >= resource.data.readBy.size()
          && (resource.data.readBy.size() < 1 || resource.data.readBy[0] in request.resource.data.readBy)
          && (resource.data.readBy.size() < 2 || resource.data.readBy[1] in request.resource.data.readBy);
      }
      function onlyOwnReceiptAdded() {
        return (request.resource.data.readBy == resource.data.readBy
            && request.auth.uid in resource.data.readBy)
          || (!(request.auth.uid in resource.data.readBy)
            && request.auth.uid in request.resource.data.readBy
            && request.resource.data.readBy.size() == resource.data.readBy.size() + 1);
      }
      allow read: if signedIn() && request.auth.uid in storedConversation().data.participantIds;
      allow create: if currentConversationParticipantCanWrite(conversation().data)
        && request.resource.data.keys().hasOnly(["conversationId", "senderId", "body", "readBy", "attachmentStatus", "createdAt"])
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in conversation().data.participantIds
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() == 1
        && request.resource.data.readBy[0] == request.auth.uid
        && request.resource.data.attachmentStatus == "upload_pending_launch"
        && request.resource.data.createdAt is timestamp
        && noStoredFileFields(request.resource.data);
      allow update: if currentConversationParticipantCanWrite(storedConversation().data)
        && validParticipantReadBy(request.resource.data.readBy, storedConversation().data.participantIds)
        && existingReceiptsPreserved()
        && onlyOwnReceiptAdded()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"]);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      function commonNotificationIsValid() {
        return request.resource.data.userId is string
          && request.resource.data.titleAr is string
          && request.resource.data.titleAr.size() > 0
          && request.resource.data.titleAr.size() <= 160
          && request.resource.data.titleEn is string
          && request.resource.data.titleEn.size() > 0
          && request.resource.data.titleEn.size() <= 160
          && request.resource.data.bodyAr is string
          && request.resource.data.bodyAr.size() > 0
          && request.resource.data.bodyAr.size() <= 500
          && request.resource.data.bodyEn is string
          && request.resource.data.bodyEn.size() > 0
          && request.resource.data.bodyEn.size() <= 500
          && (!("link" in request.resource.data)
            || (request.resource.data.link is string && request.resource.data.link.size() <= 300))
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && noStoredFileFields(request.resource.data);
      }
      function publishEvent() {
        return get(/databases/$(database)/documents/rfqPublishEvents/$(request.resource.data.eventId));
      }
      function publishTargetProfileId() {
        return userDoc(request.resource.data.userId).data.supplierProfileId;
      }
      function validPublishedRfqNotification() {
        let event = publishEvent().data;
        let targetProfileId = publishTargetProfileId();
        return currentBuyerCanWrite()
          && request.resource.data.keys().hasOnly(["userId", "actorId", "type", "referenceType", "referenceId", "eventId", "titleAr", "titleEn", "bodyAr", "bodyEn", "link", "read", "createdAt"])
          && request.resource.data.type == "rfq"
          && request.resource.data.referenceType == "rfq"
          && request.resource.data.eventId == request.resource.data.referenceId
          && notificationId == "rfq-published_" + request.resource.data.eventId + "_" + request.resource.data.userId
          && event.type == "rfq_published"
          && event.rfqId == request.resource.data.referenceId
          && event.actorId == request.auth.uid
          && event.buyerId == request.auth.uid
          && request.resource.data.actorId == request.auth.uid
          && targetProfileId in event.recipientIds
          && supplierAccountCanWrite(request.resource.data.userId, targetProfileId)
          && request.resource.data.titleAr == "طلب عرض سعر جديد"
          && request.resource.data.titleEn == "New RFQ request"
          && request.resource.data.bodyAr == "وصل طلب عرض سعر جديد إلى شركتك."
          && request.resource.data.bodyEn == "A new RFQ has been addressed to your company."
          && request.resource.data.link == "/supplier/rfqs"
          && commonNotificationIsValid();
      }
      function responseEvent() {
        return get(/databases/$(database)/documents/rfqResponseEvents/$(request.resource.data.eventId));
      }
      function validResponseNotification() {
        let event = responseEvent().data;
        return request.resource.data.keys().hasOnly(["userId", "actorId", "type", "referenceType", "referenceId", "eventId", "responseId", "titleAr", "titleEn", "bodyAr", "bodyEn", "link", "read", "createdAt"])
          && request.resource.data.type == "rfq"
          && request.resource.data.referenceType == "rfq"
          && request.resource.data.responseId == request.resource.data.eventId
          && notificationId == "rfq-response_" + request.resource.data.responseId
          && event.type == "rfq_response_submitted"
          && event.responseId == request.resource.data.responseId
          && event.rfqId == request.resource.data.referenceId
          && event.actorId == request.auth.uid
          && event.buyerId == request.resource.data.userId
          && event.supplierProfileId is string
          && currentSupplierCanWrite(event.supplierProfileId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.titleAr == "تم استلام عرض سعر"
          && request.resource.data.titleEn == "New quotation received"
          && request.resource.data.bodyAr == "استلم طلبك عرض سعر جديداً من أحد المجهزين."
          && request.resource.data.bodyEn == "A supplier submitted a quotation for your RFQ."
          && request.resource.data.link == "/buyer/rfqs"
          && commonNotificationIsValid();
      }
      function validAdminNotification() {
        return request.resource.data.keys().hasOnly(["userId", "actorId", "type", "referenceType", "referenceId", "titleAr", "titleEn", "bodyAr", "bodyEn", "link", "read", "createdAt"])
          && request.resource.data.type in ["approval", "message", "access", "submission", "system"]
          && (!("actorId" in request.resource.data) || request.resource.data.actorId == request.auth.uid)
          && (!("referenceType" in request.resource.data)
            || request.resource.data.referenceType in ["conversation", "submission", "supplier"])
          && (!("referenceId" in request.resource.data) || request.resource.data.referenceId is string)
          && commonNotificationIsValid();
      }
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if !signedIn()
        ? false
        : request.resource.data.type == "rfq"
          ? ("responseId" in request.resource.data
            ? validResponseNotification()
            : validPublishedRfqNotification())
          : isAdmin() && validAdminNotification();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);
      allow delete: if isAdmin();
    }

    match /supplierProducts/{productId} {
      allow read: if isAdmin() || (isBuyer() && hasActiveAccess()) || (isSupplierAccount() && resource.data.ownerUserId == request.auth.uid && resource.data.supplierId == myUser().supplierProfileId);
      allow create: if isSupplierAccount() && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.supplierId == myUser().supplierProfileId && request.resource.data.mediaStatus == "upload_pending_launch" && noStoredFileFields(request.resource.data);
      allow update: if isAdmin() || (isSupplierAccount() && resource.data.ownerUserId == request.auth.uid && resource.data.supplierId == myUser().supplierProfileId && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.mediaStatus == "upload_pending_launch" && noStoredFileFields(request.resource.data));
      allow delete: if isAdmin() || (isSupplierAccount() && resource.data.ownerUserId == request.auth.uid && resource.data.supplierId == myUser().supplierProfileId);
    }

    match /supplierDocuments/{documentId} {
      allow read: if isAdmin() || (isSupplierAccount() && resource.data.ownerUserId == request.auth.uid && resource.data.supplierId == myUser().supplierProfileId);
      allow create: if isSupplierAccount() && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.supplierId == myUser().supplierProfileId && request.resource.data.storageStatus in ["metadata_only", "upload_pending_launch"] && request.resource.data.verificationStatus == "unverified" && noStoredFileFields(request.resource.data);
      allow update: if isAdmin() || (isSupplierAccount() && resource.data.ownerUserId == request.auth.uid && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.storageStatus in ["metadata_only", "upload_pending_launch"] && noStoredFileFields(request.resource.data));
      allow delete: if isAdmin() || (isSupplierAccount() && resource.data.ownerUserId == request.auth.uid);
    }

    match /contentPages/{pageId} {
      allow read: if resource.data.status == "published" || isOwner();
      allow create, update, delete: if isOwner();
    }

    match /publicConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /reviews/{reviewId} {
      allow create: if isBuyer() && hasActiveAccess() && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.status == "pending_review";
      allow read: if isAdmin() || (isBuyer() && hasActiveAccess() && resource.data.status == "approved") || (isBuyer() && resource.data.reviewedBy == request.auth.uid) || isOwnSupplierProfile(resource.data.supplierId);
      allow update, delete: if isAdmin();
    }

    match /supplierFeedback/{feedbackId} {
      allow create: if isBuyer() && hasActiveAccess() && request.resource.data.submittedBy == request.auth.uid && request.resource.data.status == "pending" && request.resource.data.supplierId is string && request.resource.data.supplierName is string && request.resource.data.type in ["incorrect_information", "contact_issue", "location_issue", "category_issue", "duplicate_supplier", "business_closed", "other"] && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 1000 && request.resource.data.suggestedCorrection is string && request.resource.data.suggestedCorrection.size() <= 1000;
      allow read: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /materialTerms/{termId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /termSuggestions/{suggestionId} {
      allow create: if isBuyer() && hasActiveAccess() && request.resource.data.term is string && request.resource.data.term.size() >= 2 && request.resource.data.term.size() <= 80 && request.resource.data.normalizedTerm is string && request.resource.data.status == "pending" && request.resource.data.count is int && request.resource.data.sources is list && request.resource.data.examples is list;
      allow read: if isAdmin();
      allow update: if isAdmin() || (isBuyer() && hasActiveAccess() && resource.data.status == "pending" && request.resource.data.status == "pending" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["count", "sources", "examples", "updatedAt", "createdAt", "term", "normalizedTerm", "status"]));
      allow delete: if isAdmin();
    }

    match /accessCredits/{creditId} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow create: if isAdmin() || isValidOwnTrialCredit(creditId); allow update, delete: if isAdmin(); }
    match /accessGrants/{grantId} { allow read: if isAdmin() || (signedIn() && (grantId == "trial-" + request.auth.uid || resource.data.userId == request.auth.uid)); allow create: if isAdmin() || isValidOwnTrialCredit(grantId); allow update, delete: if false; }
    match /contributionLogs/{logId} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow create, update, delete: if isAdmin(); }
    match /categories/{categoryId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isOwner(); }
    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isOwner() || (hasAnyRole(["admin"]) && settingId == "adminOperations");
      allow delete: if isOwner();
    }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow create: if isAdmin() || isValidOwnVerificationAudit(logId) || isValidOwnSupplierImportAudit(); allow update, delete: if false; }
  }
}
