{
  "name": "mujahiz-iq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:static": "node scripts/preview-static.mjs",
    "generate:supplier-template": "node scripts/generate-supplier-import-template.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:firestore-emulator": "firebase emulators:exec --project demo-mujahiziq-integration --only firestore \"node --test --test-concurrency=1 tests/firestore-emulator.mjs tests/rfq-firestore-emulator.mjs\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^11.0.2",
    "fuse.js": "^7.0.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.21.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
